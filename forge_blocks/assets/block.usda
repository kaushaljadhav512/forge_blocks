#usda 1.0
(
    defaultPrim = "Block"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Block" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.03

    def Cube "body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3 xformOp:scale = (0.03, 0.03, 0.065)
        double3 xformOp:translate = (0, 0, 0.0325)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

